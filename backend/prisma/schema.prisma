datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Off-chain file record. The chain holds only the plaintext SHA-256.
model StoredFile {
  tokenId      String   @id
  name         String
  mimeType     String
  size         Int
  contentHash  String   @unique
  storagePath  String
  wrappedDek   String
  createdAt    DateTime @default(now())
}

/// Hash-chained decision log (spec 9.2): reads and denials, too frequent for the chain.
model Decision {
  id         Int      @id @default(autoincrement())
  ts         DateTime @default(now())
  identityId String
  tokenId    String?
  action     String
  reasonCode String
  riskScore  Int      @default(0)
  reasons    String   @default("[]")
  prevHash   String
  rowHash    String
}